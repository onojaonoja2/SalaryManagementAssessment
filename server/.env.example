# Local development (MySQL running on this machine)
DATABASE_URL="mysql://root:CHANGE_ME@127.0.0.1:3306/salary_mgmt_dev"

# JWT secret for signing HR-manager login tokens.
# MUST be a long random value in production. Never commit a real secret.
JWT_SECRET=""

# Token lifetime (e.g. 30m, 1h). Defaults to 30m.
JWT_TTL="30m"

# Port the API listens on
PORT=4000

# Comma-separated allowed CORS origins (the web app)
CORS_ORIGIN="http://localhost:5173"

# Simple HR manager credentials (single shared login for the demo).
# Set these to strong values; do NOT commit real credentials.
HR_USERNAME="hrmanager"
HR_PASSWORD=""
