# Local development (MySQL running on this machine)
DATABASE_URL="mysql://root:CHANGE_ME@127.0.0.1:3306/salary_mgmt_dev"

# JWT secret for signing login tokens.
# MUST be a long random value in production. Never commit a real secret.
JWT_SECRET=""

# Token lifetime (e.g. 30m, 1h). Defaults to 30m.
JWT_TTL="30m"

# Port the API listens on.
# Railway sets this automatically; local dev requires it.
PORT=4000

# Comma-separated allowed CORS origins.
# In production (Railway), set to your Vercel frontend URL
# e.g. "https://your-app.vercel.app"
CORS_ORIGIN="http://localhost:5173"

# Users register via POST /api/auth/signup. JWT_SECRET is the only required secret.
